{
  "name": "matka",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node dist-server/index.js",
    "start:dev": "tsx server/src/index.ts",
    "start:backend": "node dist-server/index.js",
    "dev:backend": "tsx watch server/src/index.ts",
    "dev:user": "vite --config apps/user-web/vite.config.ts apps/user-web --port 3000",
    "dev:admin": "vite --config apps/admin-web/vite.config.ts apps/admin-web --port 3002",
    "dev": "concurrently -k -n \"API,USER,ADMIN\" -c \"blue,magenta,yellow\" \"npm run dev:backend\" \"npm run dev:user\" \"npm run dev:admin\"",
    "build:server": "esbuild server/src/index.ts --platform=node --target=node20 --bundle --outfile=dist-server/index.js --external:better-sqlite3 --external:pg-native",
    "build:user": "vite build apps/user-web",
    "build:admin": "vite build apps/admin-web",
    "build": "npm run build:user && npm run build:admin && npm run build:server"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.65.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "uuid": "^14.0.3",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
